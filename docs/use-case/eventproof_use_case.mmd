        UC_MonitorLive(["Monitor Live Attendance"]):::ucStyle
        NoteSync["Note: When connection returns"]:::noteStyle

        %% System Admin / Certificates
        UC_ViewEligible(["View Certificate Eligibility"]):::ucStyle
        UC_ConfigCert(["Configure Certificate"]):::ucStyle
        UC_ManageTemplates(["Manage Certificate Templates"]):::ucStyle
        UC_CheckEligible(["Check Certificate Eligibility"]):::coreStyle
        NoteEligible["Note: Eligible only if registered and marked PRESENT."]:::noteStyle

        UC_GenPDF(["Generate Certificate PDF"]):::ucStyle
        UC_IssueCert(["Issue Certificate"]):::coreStyle
        UC_BulkIssue(["Bulk Issue Certificates"]):::ucStyle
