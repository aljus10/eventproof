    subgraph SystemBoundary ["EventProof Use Case Diagram<br><b>Offline-First Attendance and Verifiable E-Certificate Management System</b>"]

        %% Student / Attendance flow
        UC_PresentQR(["Present Event QR"]):::ucStyle
