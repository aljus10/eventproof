    %% Student Relationships
    Student --- UC_PresentQR
    Student --- UC_CheckIn
    Student --- UC_ManualLookup

    UC_PresentQR -. "<<extend>><br>[when student has QR]" .-> UC_CheckIn
    UC_ManualLookup -. "<<extend>><br>[when QR is unavailable]" .-> UC_CheckIn

    UC_CheckIn -. "<<include>>" .-> UC_Identify
    UC_CheckIn -. "<<include>>" .-> UC_ConfirmAtt
    UC_ConfirmAtt -. "<<include>>" .-> UC_RecordAtt

    %% Event Manager Relationships
    Manager --- UC_ManageEvents
    Manager --- UC_ManageStudents
    Manager --- UC_RegisterStudents
    Manager --- UC_GenPasses
    Manager --- UC_SetupScanner

    %% Scanner Staff Relationships
    Scanner --- UC_ScanQR
    Scanner --- UC_FindManual
    Scanner --- UC_SyncOffline
    Scanner --- UC_MonitorLive

    UC_ScanQR -. "<<include>>" .-> UC_Identify
    UC_FindManual -. "<<include>>" .-> UC_Identify
    UC_SyncOffline --- NoteSync

    %% System Admin Relationships
    Admin --- UC_ViewEligible
    Admin --- UC_ConfigCert
    Admin --- UC_ManageTemplates
    Admin --- UC_IssueCert
    Admin --- UC_BulkIssue
    Admin --- UC_RevokeRestore

    %% Certificate Relationships
    UC_IssueCert -. "<<include>>" .-> UC_CheckEligible
    UC_IssueCert -. "<<include>>" .-> UC_GenPDF
    UC_BulkIssue -. "<<include>>" .-> UC_IssueCert
    UC_BulkIssue -. "<<include>>" .-> UC_CheckEligible
    UC_CheckEligible --- NoteEligible

    %% Public Verifier Relationships
    Verifier --- UC_VerifyCert
    UC_VerifyCert -. "<<include>>" .-> UC_CheckCertStatus
    UC_CheckCertStatus --- NoteCertStatus
